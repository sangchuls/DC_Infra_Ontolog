# 어느 LLM을 쓸지 선택 (anthropic | gemini | openai). 미지정시 anthropic.
# LLM_PROVIDER=anthropic

# --- Anthropic (Claude) ---
# ANTHROPIC_API_KEY=sk-ant-...
# 발급: https://console.anthropic.com/settings/keys
# (ant auth login 으로 로그인한 프로필이 있으면 이 값 없이도 동작합니다.)

# --- Google Gemini ---
# GEMINI_API_KEY=AIza... 또는 AI Studio가 발급한 다른 형식의 키
# 발급: https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.1-pro-preview   # 필요시 모델 재정의

# --- OpenAI (GPT) ---
# OPENAI_API_KEY=sk-...
# 발급: https://platform.openai.com/api-keys
# OPENAI_MODEL=gpt-6-astra   # 더 저렴한 모델을 쓰려면 재정의 (예: gpt-6-luna)

# --- 계산 앱 화면 링크 (배포 후 실제 URL로 교체) ---
# 로컬 개발 중에는 비워두면 /apps/generator, /apps/chiller (로컬 정적 서빙)를 그대로 씁니다.
# GENERATOR_APP_URL=https://generator-calc.vercel.app
# CHILLER_APP_URL=https://chiller-sizing.vercel.app

# 위 값을 채운 .env 파일을 만들거나, 셸에서 직접 환경변수로 설정하세요.
# 이 .env.example 파일 자체는 git에 커밋되는 템플릿이므로 실제 키 값을 절대 적지 마세요.
